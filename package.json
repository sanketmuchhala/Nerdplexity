{
  "name": "nerdplexity",
  "version": "1.0.0",
  "description": "Master your AI conversations with intelligent prompt analytics - Local-first AI chat with real-time insights",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter @app/server dev",
    "dev:web": "pnpm --filter @app/web dev",
    "dev:ollama": "ollama serve",
    "build": "pnpm -r build",
    "start": "pnpm --filter @app/server start",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "lint": "pnpm -r lint && pnpm ci:no-emoji",
    "test": "pnpm test:browser",
    "test:browser": "playwright test",
    "ci:no-emoji": "node ./scripts/no-emoji-check.mjs",
    "deadcode": "node ./scripts/deadcode-analyzer.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^8.42.0",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.2",
    "depcheck": "^1.4.7",
    "emoji-regex": "^10.5.0",
    "eslint": "^8.45.0",
    "postcss": "^8.4.27",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.3.3",
    "ts-unused-exports": "^11.0.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.4.5",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
