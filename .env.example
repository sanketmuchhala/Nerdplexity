# Keys for the command-line harnesses only. The app itself keeps keys in the browser
# (Connections -> keyStorage "device") and never reads this file.
#
# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# Used by: backend/scripts/research-run.mjs   (npm run research)

# Deep Research searches with Exa. https://exa.ai -> API keys.
EXA_API_KEY=

# At least one provider. More than one is the point: a second provider is what
# stops a single account's per-minute or daily limit from ending a run.
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
