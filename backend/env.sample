# Nerdplexity server settings. Copy to backend/.env.local for local overrides.
# API keys are never configured here: they stay in the browser and travel with each request.

PORT=5174

# Where saved data lives. Without DATABASE_URL, PGlite keeps it in this folder (default backend/data).
# NERDPLEXITY_DATA_DIR=./data
# DATABASE_URL=postgresql://user:password@host:5432/nerdplexity
# DATABASE_POOL_SIZE=10

# Hosted deployment (Railway, Render): accounts required, private-network models refused.
# NERDPLEXITY_HOSTED=1
# BETTER_AUTH_SECRET=   # openssl rand -base64 32
# BETTER_AUTH_URL=https://your-service.up.railway.app
# ALLOWED_ORIGINS=https://your-web-app.vercel.app
# NERDPLEXITY_SIGNUPS=  # unset: first account only; open; closed
